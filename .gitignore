__pycache__/
*.pyc
.venv/
.DS_Store

# Downloaded per the README setup step -- not committed (54MB binary).
bin/tectonic

# Personal resume data -- this is user-generated local state, not
# example/sample content. Never commit your real resume, tailored
# versions, job-description history, evidence, release reports, session
# state, or generated exports. Catch-all + negations so a new data/
# subdirectory is ignored by default instead of needing its own line.
resources/master_resume.yaml
resources/master_cv.yaml
/data/**
!/data/*/
!/data/*/.gitkeep
/output/
/_to_delete/

# Editor/tool state -- never personal data itself, but not project source.
.obsidian/
.idea/
.vscode/
